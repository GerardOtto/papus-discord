# Tokens de las 4 aplicaciones de Discord (Developer Portal; intents Message Content y Server Members)
DISCORD_TOKEN_TETO=
DISCORD_TOKEN_MIKU=
DISCORD_TOKEN_LUKA=
DISCORD_TOKEN_NERU=
# Opcionales: Vocaloids que solo conversan (sin intents privilegiados; basta invitarlos al servidor). Sin token, no se conectan.
DISCORD_TOKEN_GAKUPO=
DISCORD_TOKEN_KAITO=
DISCORD_TOKEN_FLOWER=
DISCORD_TOKEN_IA=
DISCORD_TOKEN_HAKU=
DISCORD_TOKEN_GUMI=
DISCORD_TOKEN_RIN=
DISCORD_TOKEN_LEN=
DISCORD_TOKEN_MEIKO=
DISCORD_TOKEN_ADACHIREI=
DISCORD_TOKEN_RUKO=
DISCORD_GUILD_ID=
# Opcional: usuario de GyroP (exento de moderacion). Si se deja vacio, se usa el dueno del servidor.
OWNER_USER_ID=

# Claves de las APIs gratuitas (orden de la cadena: Groq -> Gemini -> OpenRouter -> Cloudflare)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Token para desplegar el worker de Miku y Luka (npm run worker:deploy): plantilla "Edit Cloudflare Workers" + D1 Edit
CLOUDFLARE_DEPLOY_TOKEN=

# Carpeta del motor de videos (lore, calendario, fuentes); rutas en config/engine-paths.json
ENGINE_DIR=../Proyecto1
# Carpetas de entrega del escritorio (opcional: videos finales y subidos)
DELIVERY_DIR=C:/Users/UsuarioCompuElite/Desktop/Proyecto vocaloid

# La cuota diaria depende del nivel de cada Papu: config/niveles.json (PLAN §3.1). Se reinicia a medianoche en esta zona:
QUOTA_RESET_TZ=America/Santiago
