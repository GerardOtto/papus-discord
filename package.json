{
  "name": "papus-discord",
  "version": "0.1.0",
  "private": true,
  "description": "Bots del servidor de Discord de los Papus (Teto, Miku, Luka y Neru): cuota compartida, frases fijas, LLM gratuito con respaldo y moderacion por reglas.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/main.ts",
    "check": "node --disable-warning=ExperimentalWarning --import tsx scripts/check.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "perfiles": "node --disable-warning=ExperimentalWarning --import tsx scripts/apply-profiles.ts",
    "avatares": "python scripts/make_avatars.py",
    "bench:local": "node --disable-warning=ExperimentalWarning --import tsx scripts/bench-local.ts",
    "servidor": "node --disable-warning=ExperimentalWarning --import tsx scripts/setup-server.ts",
    "guias": "node --disable-warning=ExperimentalWarning --import tsx scripts/post-guides.ts",
    "worker:deploy": "node --disable-warning=ExperimentalWarning --import tsx scripts/worker-deploy.ts",
    "worker:typecheck": "tsc -p worker/tsconfig.json && tsc -p worker/actividad/tsconfig.json && tsc -p worker/mundo/tsconfig.json",
    "mundo": "node --disable-warning=ExperimentalWarning --import tsx scripts/mundo.ts",
    "mundo:sprites": "python -X utf8 scripts/mundo_sprites.py",
    "mundo:mapa": "node --disable-warning=ExperimentalWarning --import tsx scripts/mundo-mapa.ts",
    "actividad": "node --disable-warning=ExperimentalWarning --import tsx scripts/actividad.ts",
    "actividad:arte": "python scripts/actividad_arte.py",
    "actividad:vista": "node --disable-warning=ExperimentalWarning --import tsx scripts/actividad-vista.ts",
    "emojis": "node --disable-warning=ExperimentalWarning --import tsx scripts/setup-emojis.ts",
    "autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1",
    "detener": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-bots.ps1",
    "bandeja": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart.ps1 bandeja",
    "iconos": "python scripts/make_tray_icons.py",
    "reiniciar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-bots.ps1 -Reiniciar",
    "despedida-al-apagar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/logoff-script.ps1",
    "pedidos": "node --disable-warning=ExperimentalWarning --import tsx scripts/pedidos.ts",
    "conversaciones": "node --disable-warning=ExperimentalWarning --import tsx scripts/conversaciones.ts",
    "niveles": "node --disable-warning=ExperimentalWarning --import tsx scripts/niveles.ts",
    "baguette": "node --disable-warning=ExperimentalWarning --import tsx scripts/baguette.ts",
    "trivia:audio": "node --disable-warning=ExperimentalWarning --import tsx scripts/trivia-audio.ts",
    "trivia:generar": "node --disable-warning=ExperimentalWarning --import tsx scripts/trivia-generar.ts",
    "trivia:imagenes": "node --disable-warning=ExperimentalWarning --import tsx scripts/trivia-imagenes.ts",
    "coleccion": "node --disable-warning=ExperimentalWarning --import tsx scripts/coleccion.ts",
    "peleas:avatares": "python scripts/peleas_avatares.py",
    "peleas:wiki": "node --disable-warning=ExperimentalWarning --import tsx scripts/peleas-wiki.ts",
    "plaza:tarjetas": "node --disable-warning=ExperimentalWarning --import tsx scripts/plaza-tarjetas.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "discord.js": "14.27.0",
    "gifenc": "1.0.3",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@discord/embedded-app-sdk": "2.5.0",
    "@types/node": "24.10.1",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "three": "0.186.1",
    "typescript": "5.7.3",
    "vitest": "5.0.3",
    "wrangler": "^4.151.1"
  }
}
